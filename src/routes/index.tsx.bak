                  </button>
                </div>

                {/* WhatsApp Contact Snippet in the Hero */}
                <div className="pt-3 border-t border-[#c8ff00]/15 flex flex-wrap items-center gap-5">
                  <a
                    href={getWhatsAppUrl("Olá! Vim pelo site e gostaria de saber valores e modelos da placa TagTap.")}

function SalesShowcase() {
  const [selectedProductIndex, setSelectedProductIndex] = useState(0);
  const [openFaq, setOpenFaq] = useState<number | null>(null);

  // Phone Simulator state directly embedded in the Hero alongside the plate
  const [phoneState, setPhoneState] = useState<"idle" | "connecting" | "screen" | "success">("idle");
  const [userRating, setUserRating] = useState(5);
  const [isFollowingInstagram, setIsFollowingInstagram] = useState(false);
  const [whatsappMessaged, setWhatsappMessaged] = useState(false);

  const currentProduct = PRODUCTS[selectedProductIndex];

  const handlePrevModel = () => {
    setSelectedProductIndex((prev) => (prev === 0 ? PRODUCTS.length - 1 : prev - 1));
    setPhoneState("idle");
    setIsFollowingInstagram(false);
    setWhatsappMessaged(false);
  };

  const handleNextModel = () => {
    setSelectedProductIndex((prev) => (prev === PRODUCTS.length - 1 ? 0 : prev + 1));
    setPhoneState("idle");
    setIsFollowingInstagram(false);
    setWhatsappMessaged(false);
  };

  const handleSelectModel = (index: number) => {
    setSelectedProductIndex(index);
    setPhoneState("idle");
    setIsFollowingInstagram(false);
    setWhatsappMessaged(false);
  };

  const handleSimulateTap = () => {
    if (phoneState === "connecting") return;
    setPhoneState("connecting");
    setTimeout(() => {
      setPhoneState("screen");
      const targetName =
        currentProduct.type === "instagram"
          ? "Perfil do Instagram"
          : currentProduct.type === "whatsapp"
          ? "Contato do WhatsApp"
          : currentProduct.type === "custom"
          ? "Linktree Saikoo Jiu Jitsu"
          : "Avaliação 5 Estrelas no Google";
      toast.success("Toque NFC Detectado!", {
        description: `Abrindo ${targetName} no celular.`,
      });
    }, 700);
  };

  const handlePublishReview = () => {
    setPhoneState("success");
    toast.success("Avaliação 5 Estrelas Publicada!", {
      description: "Sua avaliação foi contabilizada no Google Maps em 3 segundos.",
    });
  };

  const handleToggleInstagramFollow = () => {
    setIsFollowingInstagram((prev) => {
      const next = !prev;
      if (next) {
        toast.success("Você agora segue @tagtapbr!", {
          description: "Seguidor ganho instantaneamente no balcão da sua loja.",
        });
      }
      return next;
    });
  };

  const handleSendWhatsAppChat = () => {
    setWhatsappMessaged(true);
    toast.success("Conversa Iniciada no WhatsApp!", {
      description: "O contato da sua empresa foi aberto diretamente no app.",
    });
  };

  const handleResetPhone = () => {
    setPhoneState("idle");
    setUserRating(5);
    setIsFollowingInstagram(false);
    setWhatsappMessaged(false);
  };

  const scrollToSection = (e: MouseEvent<HTMLAnchorElement | HTMLButtonElement>, sectionId: string) => {
    e.preventDefault();
    const targetElement = document.getElementById(sectionId);
    if (targetElement) {
      const navOffset = 80;
      const elementPosition = targetElement.getBoundingClientRect().top;
      const offsetPosition = elementPosition + window.pageYOffset - navOffset;

      window.scrollTo({
        top: offsetPosition,
        behavior: "smooth",
      });
    }
  };

  return (
    <div className="min-h-screen bg-[#070d04] text-[#f2f7ec] selection:bg-[#c8ff00] selection:text-[#091203]">
      {/* Top Banner / Micro Header */}
      <header className="sticky top-0 z-50 backdrop-blur-md bg-[#070d04]/85 border-b border-[#c8ff00]/15">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-9 h-9 rounded-xl bg-[#c8ff00] flex items-center justify-center text-[#091203] font-black text-xl shadow-lg shadow-[#c8ff00]/30">
              <Nfc className="w-5 h-5 stroke-[2.5]" />
            </div>
            <div>
              <span className="font-extrabold text-lg tracking-wider text-white flex items-center gap-1.5">
                TAG<span className="text-[#c8ff00]">TAP</span>
                <span className="text-[10px] uppercase font-bold tracking-widest bg-[#182a0d] text-[#c8ff00] px-2 py-0.5 rounded-full border border-[#c8ff00]/30">
                  NFC 8x8cm
                </span>
              </span>
            </div>
          </div>

          {/* Navigation Links in the middle with smooth scroll animation */}
          <nav className="hidden md:flex items-center gap-1 lg:gap-2 p-1 rounded-full bg-[#101b0a]/80 border border-[#c8ff00]/20">
            <button
              onClick={(e) => scrollToSection(e, "como-funciona")}
              className="px-3.5 py-1.5 rounded-full text-xs uppercase tracking-wider font-bold text-[#b4cca4] hover:text-[#091203] hover:bg-[#c8ff00] transition-all duration-200 cursor-pointer"
            >
              Como Funciona
            </button>
            <button
              onClick={(e) => scrollToSection(e, "modelos")}
              className="px-3.5 py-1.5 rounded-full text-xs uppercase tracking-wider font-bold text-[#b4cca4] hover:text-[#091203] hover:bg-[#c8ff00] transition-all duration-200 cursor-pointer"
            >
              Modelos
            </button>
            <button
              onClick={(e) => scrollToSection(e, "precos")}
              className="px-3.5 py-1.5 rounded-full text-xs uppercase tracking-wider font-bold text-[#b4cca4] hover:text-[#091203] hover:bg-[#c8ff00] transition-all duration-200 cursor-pointer"
            >
              Tabela de Preços
            </button>
            <button
              onClick={(e) => scrollToSection(e, "personalizada-destaque")}
              className="px-3.5 py-1.5 rounded-full text-xs uppercase tracking-wider font-bold text-[#b4cca4] hover:text-[#091203] hover:bg-[#c8ff00] transition-all duration-200 cursor-pointer"
            >
              Personalizadas
            </button>
            <button
              onClick={(e) => scrollToSection(e, "faq")}
              className="px-3.5 py-1.5 rounded-full text-xs uppercase tracking-wider font-bold text-[#b4cca4] hover:text-[#091203] hover:bg-[#c8ff00] transition-all duration-200 cursor-pointer"
            >
              Dúvidas
            </button>
          </nav>

          <div className="flex items-center gap-3">
            <span className="hidden sm:inline-flex items-center gap-1.5 text-xs font-medium text-[#c8ff00] bg-[#14230a] px-3 py-1 rounded-full border border-[#c8ff00]/25">
              <span className="w-2 h-2 rounded-full bg-[#c8ff00] animate-pulse"></span>
              {CONTACT.location}
            </span>
            <a
              href={getWhatsAppUrl("Olá! Gostaria de saber mais sobre as placas NFC 8x8cm para meu comércio.")}
              target="_blank"
              rel="noreferrer"
              className="inline-flex items-center gap-1.5 bg-[#c8ff00] hover:bg-[#b2e600] text-[#091203] px-3.5 py-1.5 rounded-full font-bold text-xs sm:text-sm tracking-tight transition-transform active:scale-95 shadow-md shadow-[#c8ff00]/20"
            >
              <MessageCircle className="w-4 h-4 fill-[#091203]" />
              <span className="hidden xs:inline">WhatsApp</span>
            </a>
          </div>
        </div>
      </header>

      {/* Main Container */}
      <main className="max-w-7xl mx-auto px-4 sm:px-6 py-6 md:py-10 space-y-16 md:space-y-24">
        
        {/* ============================================================ */}
        {/* HERO SECTION: PLACA NFC + IPHONE TITANIUM LADO A LADO        */}
        {/* ============================================================ */}
        <section className="relative">
          {/* Ambient Glows */}
          <div className="absolute -top-10 left-1/2 -translate-x-1/2 w-96 h-96 bg-[#c8ff00]/15 rounded-full blur-[120px] pointer-events-none"></div>

          {/* Master Flyer Card */}
          <div className="relative rounded-[2.5rem] p-6 sm:p-8 md:p-12 overflow-hidden border border-[#c8ff00]/25 shadow-2xl shadow-black/80 bg-gradient-to-b from-[#14230b] via-[#0d1607] to-[#080e04]">
            
            {/* The Signature Vibrant Lime Organic Shape Backdrop */}
            <div className="absolute -bottom-24 -right-24 w-[380px] sm:w-[540px] md:w-[680px] h-[380px] sm:h-[540px] md:h-[680px] rounded-full bg-gradient-to-tr from-[#90d400] to-[#c8ff00] opacity-90 blur-sm pointer-events-none transform rotate-12 scale-110"></div>
            
            {/* Inner Dark Curve that creates the stylized fluid cutout of the reference */}
            <div className="absolute -bottom-48 -right-48 w-[420px] sm:w-[580px] md:w-[700px] h-[420px] sm:h-[580px] md:h-[700px] rounded-[3.5rem] bg-[#0c1406]/85 pointer-events-none transform -rotate-12"></div>

            <div className="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-10 items-center">
              
              {/* Left Column: Bold Typography & Direct Sales Pitch */}
              <div className="lg:col-span-6 space-y-6">
                
                {/* Back / Tag Pills */}
                <div className="flex flex-wrap items-center gap-2">
                  <span className="inline-flex items-center gap-1.5 text-xs uppercase tracking-wider font-extrabold px-3 py-1 rounded-full bg-[#1e340e] text-[#c8ff00] border border-[#c8ff00]/30">
                    <Sparkles className="w-3.5 h-3.5" />
                    Placas Inteligentes 8x8cm
                  </span>
                  <span className="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-black/40 text-[#c8ff00] border border-[#c8ff00]/20">
                    <Star className="w-3.5 h-3.5 fill-[#c8ff00]" />
                    A partir de R$ 50,00 (+4x)
                  </span>
                </div>

                {/* Big Headline styled like "Garanta seu Apple Watch!" */}
                <div className="space-y-1">
                  <h1 className="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight leading-[1.05] text-white">
                    Garanta sua{" "}
                    <span className="text-[#c8ff00] block drop-shadow-[0_0_35px_rgba(200,255,0,0.4)]">

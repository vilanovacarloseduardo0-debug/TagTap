                </div>

                {/* Action Buttons with Smooth Scrolling */}
                <div className="flex flex-wrap items-center gap-3 pt-2">
                  <button
                    onClick={(e) => scrollToSection(e, "precos")}
                    className="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-2xl bg-[#c8ff00] hover:bg-[#b5e800] text-[#080f03] font-black text-sm uppercase tracking-wider transition-all duration-200 shadow-xl shadow-[#c8ff00]/30 hover:scale-[1.03] active:scale-95 cursor-pointer"
